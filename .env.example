# ── H.İ.S.A.R. backend configuration ────────────────────────────────────
# Copy to .env and fill in. Never commit the real file.

# The sandbox. Every path the API touches resolves inside this directory.
HISAR_SANDBOX_ROOT=/opt/hisar/vault

# Public hostname. speda-mark6's deploy.sh reads this to generate the Caddy
# site block (caddy-sites/hisar.caddy) — leave it blank and Hisar runs without
# a TLS front door. It is a sibling of SPEDA's $DOMAIN, not a subdomain.
HISAR_PUBLIC_DOMAIN=hisar.spedatox.systems

# ── Owner login ─────────────────────────────────────────────────────────
HISAR_OWNER_USERNAME=ahmet
# Generate with:  python -m server.auth hash-password
HISAR_OWNER_PASSWORD_HASH=
# Generate with:  openssl rand -base64 48
HISAR_JWT_SECRET=
HISAR_JWT_TTL=43200
# Set to false only for local HTTP development.
HISAR_COOKIE_SECURE=true

# ── Machine credential (SPEDA agents, Forge) ────────────────────────────
# Write-only, confined to /SPEDA and /Forge. Generate with:
#   openssl rand -hex 32
HISAR_MACHINE_TOKEN=

# ── Limits ──────────────────────────────────────────────────────────────
HISAR_MAX_UPLOAD_BYTES=2147483648
HISAR_LOGIN_RATE_LIMIT=8
HISAR_LOGIN_RATE_WINDOW=300

# ── Google Drive (optional) ─────────────────────────────────────────────
# From a Google Cloud OAuth 2.0 "Web application" client. Leave blank to hide
# the Drive mount entirely.
# The redirect URI must match the one registered in Google Cloud exactly.
HISAR_GOOGLE_CLIENT_ID=
HISAR_GOOGLE_CLIENT_SECRET=
HISAR_GOOGLE_REDIRECT_URI=https://hisar.spedatox.systems/drive/oauth/callback
# Where the refresh token is stored (0600). Defaults inside the vault's .hisar/.
# HISAR_GOOGLE_TOKEN_STORE=/opt/hisar/vault/.hisar/google_token.json

# ── Serving ─────────────────────────────────────────────────────────────
HISAR_STATIC_DIR=/app/dist
# Only needed when the client is served from a different origin (vite dev).
# HISAR_CORS_ORIGINS=http://localhost:5173
